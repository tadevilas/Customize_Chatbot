# ── Phase 9 — Backend Dockerfile ────────────────────────────────────────────
# Multi-stage build: keeps the final image lean by installing deps in a
# build stage and copying only the installed packages to the runtime stage.
#
# Build:  docker build -f Dockerfile.backend -t agentic-ai-backend .
# Run:    docker run --env-file .env -p 8000:8000 agentic-ai-backend
# ─────────────────────────────────────────────────────────────────────────────

# ── Stage 1: dependency installer ────────────────────────────────────────────
FROM python:3.11-slim AS builder

WORKDIR /build

# Install build tools needed by some Python packages (e.g. chromadb, sentence-transformers)
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy only the dependency manifest first (layer-cache friendly)
COPY requirements.txt .

# Install into an isolated prefix so we can copy it cleanly
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt


# ── Stage 2: runtime image ───────────────────────────────────────────────────
FROM python:3.11-slim AS runtime

WORKDIR /app

# Copy installed packages from builder
COPY --from=builder /install /usr/local

# Copy application source (data/ is excluded by .dockerignore and created below)
COPY backend/ ./backend/

# Create required directories (volumes will override at runtime)
RUN mkdir -p data/uploads chroma_db

# Disable HuggingFace symlink warnings on Linux containers
ENV HF_HUB_DISABLE_SYMLINKS_WARNING=1
ENV PYTHONUNBUFFERED=1

EXPOSE 8000

CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
